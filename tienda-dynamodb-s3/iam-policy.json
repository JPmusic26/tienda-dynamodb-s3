{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["dynamodb:Scan", "dynamodb:GetItem", "dynamodb:PutItem"],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:*:table/clientes",
        "arn:aws:dynamodb:us-east-1:*:table/productos",
        "arn:aws:dynamodb:us-east-1:*:table/ventas"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::jorge-privado", "arn:aws:s3:::jorge-privado/*"]
    }
  ]
}
